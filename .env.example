# Niti backend configuration.
# Copy to .env and fill in values. Never commit .env.

# --- LLM providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# auto = Anthropic if its key exists, else OpenAI, else mock.
# Force a provider with anthropic | openai | mock.
EXTRACTION_PROVIDER=auto
# Optional override, e.g. claude-3-5-sonnet-latest or gpt-4o
EXTRACTION_MODEL=

# --- Voice ---
SARVAM_API_KEY=

# --- Vector store ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=niti_chunks
DENSE_EMBEDDING_MODEL=intfloat/multilingual-e5-large
SPARSE_EMBEDDING_MODEL=Qdrant/bm25

# --- Feature flags (mock-first until keys are available) ---
USE_MOCK_LLM=true
USE_MOCK_TTS=true
USE_DOCLING=false

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
DATA_DIR=data
