# Niti backend configuration.
# Copy to .env and fill in values. Never commit .env.

# --- LLM providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# --- Voice ---
SARVAM_API_KEY=

# --- Vector store ---
QDRANT_URL=
QDRANT_API_KEY=

# --- Feature flags (mock-first until keys are available) ---
USE_MOCK_LLM=true
USE_MOCK_TTS=true
USE_DOCLING=false

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
DATA_DIR=data
