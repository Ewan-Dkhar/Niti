# Niti backend configuration.
# Copy to .env and fill in values. Never commit .env.

# --- LLM providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# auto = Anthropic if its key exists, else OpenAI, else Groq, else mock.
# Force a provider with anthropic | openai | groq | mock.
EXTRACTION_PROVIDER=auto
# Optional override, e.g. claude-3-5-sonnet-latest, gpt-4o, or openai/gpt-oss-120b
EXTRACTION_MODEL=
# Groq model used for 60-second vernacular scripts
SIMPLIFICATION_MODEL=openai/gpt-oss-120b

# Sarvam Bulbul v3 text-to-speech (mock WAV when USE_MOCK_TTS=true or key absent)
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=shreya

# Live government feeds (undocumented endpoints, override if they move)
MYSCHEME_API_URL=https://www.myscheme.gov.in/api/apisetu/schemes
PIB_RSS_URL=https://pib.gov.in/RssMain.aspx?ModId=6&Lang=1&Regid=3

# --- Voice ---
SARVAM_API_KEY=

# --- Vector store ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=niti_chunks
DENSE_EMBEDDING_MODEL=intfloat/multilingual-e5-large
SPARSE_EMBEDDING_MODEL=Qdrant/bm25

# --- Feature flags (mock-first until keys are available) ---
USE_MOCK_LLM=true
USE_MOCK_TTS=true
USE_DOCLING=false
# Serve parsed documents only from data/cache (no network) for offline demos.
OFFLINE_MODE=false

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATA_DIR=data
